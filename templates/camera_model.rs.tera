#[inline]
#[must_use]
#[cfg_attr(any(debug_assertions, feature = "glam-assert"), track_caller)]
pub fn look_at_affine3(
    eye: {{ vec3 }},
    center: {{ vec3 }},
    up: {{ vec3 }},

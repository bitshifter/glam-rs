// Generated from {{template_path}} template. Edit the template, not the generated file.
#[macro_use]
mod support;
{% if scalar_t == "f16" %}
#[cfg(feature = "f16")]
use half::f16;
{% endif %}
{% set dim4 = [0, 1, 2, 3] %}
{% set dim3 = [0, 1, 2] %}
{% set dim2 = [0, 1] %}
{% set e = ["x", "y", "z", "w"] %}
{% if scalar_t == "f16" %}
    {% set val = ["f16::from_f32_const(1.0)", "f16::from_f32_const(2.0)", "f16::from_f32_const(3.0)", "f16::from_f32_const(4.0)"] %}
    {% set val_rhs = ["f16::from_f32_const(11.0)", "f16::from_f32_const(12.0)", "f16::from_f32_const(13.0)"] %}
{% else %}
    {% set val = ["1_" ~ scalar_t, "2_" ~ scalar_t, "3_" ~ scalar_t, "4_" ~ scalar_t] %}
    {% set val_rhs = ["11_" ~ scalar_t, "12_" ~ scalar_t, "13_" ~ scalar_t] %}
{% endif %}
{% if scalar_t == "f32" %}
    {% set prefix = "" %}
{% elif scalar_t == "f64" %}
    {% set prefix = "d" %}
{% elif scalar_t == "i32" %}
    {% set prefix = "i" %}
{% elif scalar_t == "u32" %}
    {% set prefix = "u" %}
{% elif scalar_t == "f16" %}
    {% set prefix = "h" %}
{% else %}
    {% set prefix = scalar_t %}
{% endif %}

{% set vec2_t = prefix ~ "vec2" %}
{% set vec3_t = prefix ~ "vec3" %}
{% set vec4_t = prefix ~ "vec4" %}

{% if scalar_t == "f32" %}
    {% set vec3_variants = ["vec3a", vec3_t] %}
    {% set feature = "" %}
{% else %}
    {% set vec3_variants = [vec3_t] %}
    {% set feature = scalar_t %}
{% endif %}

{% if feature != "" %}
#[cfg(feature = "{{feature}}")]
{%- endif %}
glam_test!(test_{{vec4_t}}_swizzles, {
    use glam::{{"{"}}{{vec2_t}}, {{vec3_t}}, {{vec4_t}}, Vec4Swizzles{{"}"}};
    let v = {{vec4_t}}({{val[0]}}, {{val[1]}}, {{val[2]}}, {{val[3]}});
    let rhs3 = {{vec3_t}}({{val_rhs[0]}}, {{val_rhs[1]}}, {{val_rhs[2]}});
    let rhs2 = {{vec2_t}}({{val_rhs[0]}}, {{val_rhs[1]}});
    assert_eq!(v, v.xyzw());
    {% for j0 in dim4 %}
        {%- for j1 in dim4 %}
            {%- for j2 in dim4 %}
                {%- for j3 in dim4 %}
                    {%- if j0 != 0 or j1 != 1 or j2 != 2 or j3 != 3 -%}
                        assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}{{e[j3]}}(), {{vec4_t}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}, {{val[j3]}}));
                    {%- endif %}
                {%- endfor %}
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim4 %}
        {%- for j1 in dim4 %}
            {%- for j2 in dim4 %}
                assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}(), {{vec3_t}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}));
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim4 %}
        {%- for j1 in dim4 %}
            {%- for j2 in dim4 %}
                {%- if j0 != j1 and j0 != j2 and j1 != j2 -%}
                assert_eq!(v.with_{{e[j0]}}{{e[j1]}}{{e[j2]}}(rhs3), {{vec4_t}}(
                    {% if j0 == 0 %}{{val_rhs[0]}}{% elif j1 == 0 %}{{val_rhs[1]}}{% elif j2 == 0 %}{{val_rhs[2]}}{% else %}{{val[0]}}{% endif %},
                    {% if j0 == 1 %}{{val_rhs[0]}}{% elif j1 == 1 %}{{val_rhs[1]}}{% elif j2 == 1 %}{{val_rhs[2]}}{% else %}{{val[1]}}{% endif %},
                    {% if j0 == 2 %}{{val_rhs[0]}}{% elif j1 == 2 %}{{val_rhs[1]}}{% elif j2 == 2 %}{{val_rhs[2]}}{% else %}{{val[2]}}{% endif %},
                    {% if j0 == 3 %}{{val_rhs[0]}}{% elif j1 == 3 %}{{val_rhs[1]}}{% elif j2 == 3 %}{{val_rhs[2]}}{% else %}{{val[3]}}{% endif %}
                ));
                {%- endif %}
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim4 %}
        {%- for j1 in dim4 %}
            assert_eq!(v.{{e[j0]}}{{e[j1]}}(), {{vec2_t}}({{val[j0]}}, {{val[j1]}}));
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim4 %}
        {%- for j1 in dim4 %}
            {%- if j0 != j1 %}
                assert_eq!(v.with_{{e[j0]}}{{e[j1]}}(rhs2), {{vec4_t}}(
                    {% if j0 == 0 %}{{val_rhs[0]}}{% elif j1 == 0 %}{{val_rhs[1]}}{% else %}{{val[0]}}{% endif %},
                    {% if j0 == 1 %}{{val_rhs[0]}}{% elif j1 == 1 %}{{val_rhs[1]}}{% else %}{{val[1]}}{% endif %},
                    {% if j0 == 2 %}{{val_rhs[0]}}{% elif j1 == 2 %}{{val_rhs[1]}}{% else %}{{val[2]}}{% endif %},
                    {% if j0 == 3 %}{{val_rhs[0]}}{% elif j1 == 3 %}{{val_rhs[1]}}{% else %}{{val[3]}}{% endif %}
                ));
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
});

{% for vec3_variant in vec3_variants %}
{% if feature != "" %}
#[cfg(feature = "{{feature}}")]
{%- endif %}
glam_test!(test_{{vec3_variant}}_swizzles, {
    use glam::{{"{"}}{{vec2_t}}, {{vec3_variant}}, {{vec4_t}}, Vec3Swizzles{{"}"}};
    let v = {{vec3_variant}}({{val[0]}}, {{val[1]}}, {{val[2]}});
    let rhs2 = {{vec2_t}}({{val_rhs[0]}}, {{val_rhs[1]}});
    assert_eq!(v, v.xyz());
    {%- for j0 in dim3 %}
        {%- for j1 in dim3 %}
            {%- for j2 in dim3 %}
                {%- for j3 in dim3 %}
                    assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}{{e[j3]}}(), {{vec4_t}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}, {{val[j3]}}));
                {%- endfor %}
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim3 %}
        {%- for j1 in dim3 %}
            {%- for j2 in dim3 %}
                {%- if j0 != 0 or j1 != 1 or j2 != 2 %}
                    assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}(), {{vec3_variant}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}));
                {%- endif %}
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim3 %}
        {%- for j1 in dim3 %}
            assert_eq!(v.{{e[j0]}}{{e[j1]}}(), {{vec2_t}}({{val[j0]}}, {{val[j1]}}));
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim3 %}
        {%- for j1 in dim3 %}
            {%- if j0 != j1 %}
                assert_eq!(v.with_{{e[j0]}}{{e[j1]}}(rhs2), {{vec3_variant}}(
                    {% if j0 == 0 %}{{val_rhs[0]}}{% elif j1 == 0 %}{{val_rhs[1]}}{% else %}{{val[0]}}{% endif %},
                    {% if j0 == 1 %}{{val_rhs[0]}}{% elif j1 == 1 %}{{val_rhs[1]}}{% else %}{{val[1]}}{% endif %},
                    {% if j0 == 2 %}{{val_rhs[0]}}{% elif j1 == 2 %}{{val_rhs[1]}}{% else %}{{val[2]}}{% endif %}
                ));
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
});
{% endfor %}

{% if feature != "" %}
#[cfg(feature = "{{feature}}")]
{%- endif %}
glam_test!(test_{{vec2_t}}_swizzles, {
    use glam::{{"{"}}{{vec2_t}}, {{vec3_t}}, {{vec4_t}}, Vec2Swizzles{{"}"}};
    let v = {{vec2_t}}({{val[0]}}, {{val[1]}});
    assert_eq!(v, v.xy());
    {%- for j0 in dim2 %}
        {%- for j1 in dim2 %}
            {%- for j2 in dim2 %}
                {%- for j3 in dim2 %}
                    assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}{{e[j3]}}(), {{vec4_t}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}, {{val[j3]}}));
                {%- endfor %}
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim2 %}
        {%- for j1 in dim2 %}
            {%- for j2 in dim2 %}
                assert_eq!(v.{{e[j0]}}{{e[j1]}}{{e[j2]}}(), {{vec3_t}}({{val[j0]}}, {{val[j1]}}, {{val[j2]}}));
            {%- endfor %}
        {%- endfor %}
    {%- endfor %}
    {%- for j0 in dim2 %}
        {%- for j1 in dim2 %}
            {%- if j0 != 0 or j1 != 1 %}
                assert_eq!(v.{{e[j0]}}{{e[j1]}}(), {{vec2_t}}({{val[j0]}}, {{val[j1]}}));
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
});
